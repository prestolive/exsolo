import { defineComponent, ref, createVNode, watchEffect } from 'vue'
import {
  Space as TSpace,
  Button as TButton,
  Dropdown as TDropdown,
  Tree as TTree,
  Icon as TIcon,
  Form as TForm,
  FormItem as TFormItem,
  Input as TInput,
  Select as TSelect,
  Option as TOption,
  FormInstanceFunctions,
  SubmitContext,
  MessagePlugin,
  DialogPlugin,
} from 'tdesign-vue-next'
import {
  BaseTableCol,
  Pagination,
  BaseConditionCol,
  ExPlugin,
  ExTable,
} from '@/console/index.d'

import { post, ${ObjectName} } from './API'
const FORM_RULES = {
  #foreach ($field in $fields)
  #if(${field.required})
  ${field.code}: [{ required: true, message: '${field.name}必填' }],
  #end
  #end
}
const AddForm = defineComponent({
  name: 'AddForm',
  emits: ['finish', 'change'],
  setup(props, { emit }) {

    const formData = ref<${ObjectName}>({})
    // const form = ref<FormInstanceFunctions>()
    const handleReset = () => {
      formData.value = {}
    }
    const handleSubmit = (context: SubmitContext) => {
      const { validateResult, firstError } = context
      if (validateResult === true) {
        post('api/${sysName}/${moduleName}/${bizName}/add', {
          po: formData.value,
        }).then(() => {
          MessagePlugin.success('提交成功')
          handleReset()
          //先change再finish，先finish界面会被干掉
          emit('change')
          emit('finish')
        })
      } else {
        console.log('Validate Errors: ', firstError, validateResult)
        MessagePlugin.warning(firstError || '')
      }
    }
    return () => (
      <TForm
        ref="form"
        rules={FORM_RULES}
        data={formData}
        onReset={handleReset}
        onSubmit={handleSubmit}
      >
        #foreach ($field in $fields)
        #if($field.inForm)
<TFormItem label="${field.name}" name="${field.code}">
          <TInput v-model={formData.value.${field.code}} placeholder="${field.name}"></TInput>
        </TFormItem>
        #end
        #end
          <TSpace size="small">
            <TButton theme="primary" type="submit">
              提交
            </TButton>
            <TButton theme="default" variant="base" type="reset">
              重置
            </TButton>
          </TSpace>
      </TForm>
    )
  },
})
const EditForm = defineComponent({
  name: 'EditForm',
  emits: ['finish', 'change'],
  props: {
    id: {
      type: String,
      default: null,
    },
  },
  setup(props, { emit }) {
    const targetId = ref(props.id)
    const formData = ref<${ObjectName}>({})

    watchEffect(() => {
      if (targetId.value) {
        post('api/${sysName}/${moduleName}/${bizName}/info', {
          id: targetId.value,
        }).then((po) => {
          formData.value = { ...po }
        })
      }
    })

    // const form = ref<FormInstanceFunctions>()
    const handleReset = () => {
      formData.value = {}
    }
    const handleSubmit = (context: SubmitContext) => {
      const { validateResult, firstError } = context
      if (validateResult === true) {
        post('api/${sysName}/${moduleName}/${bizName}/update', {
          po: formData.value,
        }).then(() => {
          MessagePlugin.success('提交成功')
          handleReset()
          //先change再finish，先finish界面会被干掉
          emit('change')
          emit('finish')
        })
      } else {
        console.log('Validate Errors: ', firstError, validateResult)
        MessagePlugin.warning(firstError || '')
      }
    }
    return () => (
      <TForm
        ref="form"
        rules={FORM_RULES}
        data={formData}
        onReset={handleReset}
        onSubmit={handleSubmit}
      >
        #foreach ($field in $fields)
        #if($field.inForm)
<TFormItem label="${field.name}" name="${field.code}">
          <TInput v-model={formData.value.${field.code}} placeholder="${field.name}"></TInput>
        </TFormItem>
        #end
        #end
        <TFormItem>
          <TSpace size="small">
            <TButton theme="primary" type="submit">
              提交
            </TButton>
            <TButton theme="default" variant="base" type="reset">
              重置
            </TButton>
          </TSpace>
        </TFormItem>
      </TForm>
    )
  },
})
const ListPage = defineComponent({
  name: '${BizName}List',
  setup() {
    const columns: BaseTableCol[] = [
  #foreach ($field in $fields)
  #if($field.inTable)
  { colKey: '${field.code}', title: '${field.name}' },
  #end
  #end
    ]
    const conditions: BaseConditionCol[] = [
  #foreach ($field in $fields)
  #if($field.inCondition)
    {
    key: '${field.code}',
    title: '${field.name}',
    schema: '${field.inputType}',
    compare: '${field.compareType}',
    #if($field.inputArg)
    arg: '${field.inputArg}',
    #end
    },
  #end
  #end
    ]
    const exTableRef = ref()
    const handleLoad = (param: object, pagination: Pagination) => {
      return post('api/${sysName}/${moduleName}/${bizName}/page', {
        ...param,
        pagination: pagination,
      })
    }
    const handleAdd = () => {
      ExPlugin.dialog(
        { title: '创建', width: '520px' },
        createVNode(AddForm, {
          onChange: () => {
            exTableRef.value.refresh()
          },
        })
      )
    }
    const handleEdit = (id: string) => {
      ExPlugin.dialog(
        { title: '修改', width: '520px' },
        createVNode(EditForm, {
          id: id,
          onChange: () => {
            exTableRef.value.refresh()
          },
        })
      )
    }
    const handleDelete = (id: string) => {
      const confirmDialog = DialogPlugin.confirm({
        header: '确认删除？',
        onConfirm: () => {
          post('api/${sysName}/${moduleName}/${bizName}/delete', { id: id })
            .then(() => {
              MessagePlugin.success('删除成功')
            })
            .then(() => {
              exTableRef.value.refresh()
            })
          confirmDialog.destroy()
        },
      })
    }
    return () => (
      <div class="main" style="padding: 24px;">
        <h1>功能名称</h1>
        <ExTable
          ref={exTableRef}
          columns={columns}
          conditions={conditions}
          load={handleLoad}
        >
          {{
            tableBar: () => (
              <TButton theme="primary" onClick={handleAdd}>
                创建
              </TButton>
            ),
            rowAction: ({ row }) => (
              <TSpace>
                <TButton
                  theme="default"
                  variant="text"
                  size="small"
                  icon={() => <TIcon name="jump" />}
                  onClick={() => handleEdit(row.id)}
                ></TButton>
                <TButton
                  theme="default"
                  variant="text"
                  size="small"
                  icon={() => <TIcon name="delete" />}
                  onClick={() => handleDelete(row.id)}
                ></TButton>
              </TSpace>
            ),
          }}
        </ExTable>
      </div>
    )
  },
})
export { ListPage, AddForm, EditForm }
